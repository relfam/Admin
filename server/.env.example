# Same Postgres database the EventX-mobile-latest server uses — the admin app reads real
# users/events/gift_records/family_links from it, and owns its own additional tables
# (admins, subscriptions, fraud_cases, support_tickets, ads, audit_logs, faqs, announcements,
# app_settings) created in the same database on startup.
PORT=4100
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=postgres
PGPASSWORD=
PGDATABASE=relfam

# Used to sign/verify admin session tokens are legitimate server-issued values (defense in depth
# on top of the random token itself — see hashPassword/verifyPassword in db.js).
ADMIN_TOKEN_PEPPER=

# One-time seed: if the admins table is empty on startup, a Super Admin account is created with
# these values so you have a way to log in. Change the password after first login (Admin
# Management screen), or just leave these blank after the first successful boot.
ADMIN_SEED_NAME=Louis A
ADMIN_SEED_EMAIL=admin@relfam.app
ADMIN_SEED_PASSWORD=

# ---- Backups and monitoring (see ops.js) ----
# Backups are verified, kept per the policy below, and regularly restored into a temporary database to prove they work.
# BACKUP_DIR=            # where backups are written (default: ./backups)
# BACKUP_COPY_DIR=       # a SECOND location (another drive, a synced or network folder). A backup on the same disk as the database is lost with it.
# BACKUP_KEEP_DAILY=14   # keep the newest backup of each of the last N days
# BACKUP_KEEP_WEEKLY=8   # ...N weeks
# BACKUP_KEEP_MONTHLY=6  # ...N months
# RESTORE_TEST_EVERY_HOURS=24
# PG_BIN_DIR=            # folder with pg_dump / psql / createdb / dropdb, if not the default PostgreSQL install
# The app server is watched at this address; three failed checks in a row raise a "server is DOWN" alert.
# APP_HEALTH_URL=http://localhost:4000/health
# Alerts are always shown on the System Health screen; set BOTH of these to also get them by email (Resend).
# ALERT_EMAIL_TO=you@example.com
# RESEND_API_KEY=
# ALERT_EMAIL_FROM=Relfam Alerts <alerts@yourdomain>
